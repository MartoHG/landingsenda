---
/*
 * Acción principal del cierre: escribirle al equipo para ver SENDA en la
 * escuela. Mientras el canal no esté definido, muestra el pendiente visible.
 */
import { contacto } from '../data/secciones';
---

{
  contacto.disponible ? (
    <a class="boton boton--sobre-oscuro" href={contacto.href}>
      {contacto.rotulo}
    </a>
  ) : (
    <p class="falta">[FALTA: {contacto.falta}]</p>
  )
}
