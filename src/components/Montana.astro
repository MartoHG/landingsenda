---
/*
 * La montaña completa, apilada en tramos que reconstruyen la tira exacta.
 * Solo se ve en el modo cámara (html.con-camara). En el modo quieto cada
 * parada muestra su propio recorte.
 *
 * Contrato con src/scripts/camara.ts:
 * - [data-camara]: ventana de la cámara.
 * - [data-montana]: contenedor que la cámara desplaza y acerca, con
 *   data-ancho y data-alto en píxeles de la tira original.
 * - [data-tramo]: cada tramo, con data-y y data-alto en píxeles de la tira.
 */
import { Picture } from 'astro:assets';
import montana from '../data/montana.json';

const imagenes = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/montana/tramo-*.jpg',
  { eager: true },
);
---

<div class="camara" data-camara aria-hidden="true">
  <div
    class="montana"
    data-montana
    data-ancho={montana.ancho}
    data-alto={montana.alto}
  >
    {
      montana.tramos.map((tramo, i) => (
        <Picture
          src={imagenes[`../assets/montana/${tramo.archivo}`].default}
          formats={['avif', 'webp']}
          widths={[768, 1152, 1536, 2304, 3072]}
          sizes="(min-width: 48rem) 250vw, 350vw"
          alt=""
          class="montana__tramo"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
          decoding="async"
          data-tramo={i + 1}
          data-y={tramo.y}
          data-alto={tramo.alto}
        />
      ))
    }
  </div>
</div>
