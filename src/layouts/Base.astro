---
import '@fontsource/dm-sans/latin-700.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/camara.css';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const {
  titulo = 'SENDA · Gestión académica para escuelas secundarias',
  descripcion = 'Cada docente carga una sola vez la asistencia, el libro de temas y las calificaciones, y SENDA completa el RITE, la intensificación y el plan de acompañamiento.',
} = Astro.props;

const sitio = 'https://sendaedu.com.ar';
const canonica = new URL(Astro.url.pathname, sitio).href;
const imagenCompartir = new URL('/og.png', sitio).href;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <meta name="theme-color" content="#1a6b3a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="SENDA" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenCompartir} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  import '../scripts/contenido';
</script>
